+
+    def _apply_sort_and_paging(
+        self,
+        docs: list[Document],
+        sort_by: Optional[list[str]] = None,
+        limit: Optional[int] = None,
+        offset: int = 0
+    ) -> list[Document]:
+        """
+        Apply sorting and paging to a list of documents.
+
+        :param docs: List of documents to process
+        :param sort_by: List of field names to sort by. Prefix with '-' for descending.
+        :param limit: Maximum number of documents to return (None for no limit)
+        :param offset: Number of documents to skip
+        :returns: Processed list of documents
+        """
+        # Validate sort_by
+        if sort_by is not None:
+            if not isinstance(sort_by, list):
+                raise TypeError('sort_by must be a list of strings')
+            for field in sort_by:
+                if not isinstance(field, str):
+                    raise TypeError('sort_by must be a list of strings')
+
+        # Validate limit
+        if limit is not None:
+            if not isinstance(limit, int):
+                raise TypeError('limit must be an integer or None')
+            if limit < 0:
+                raise ValueError('limit must be non-negative')
+
+        # Validate offset
+        if not isinstance(offset, int):
+            raise TypeError('offset must be an integer')
+        if offset < 0:
+            raise ValueError('offset must be non-negative')
+
+        # Apply sorting if requested
+        if sort_by:
+            # Build sort keys in reverse order (last key first) for stable multi-field sort
+            for field in reversed(sort_by):
+                reverse = False
+                if field.startswith('-'):
+                    reverse = True
+                    field = field[1:]
+
+                def make_key_func(f):
+                    def key_func(doc):
+                        return doc.get(f)
+                    return key_func
+
+                docs.sort(key=make_key_func(field), reverse=reverse)
+
+        # Apply paging
+        if offset:
+            docs = docs[offset:]
+        if limit is not None:
+            docs = docs[:limit]
+
+        return docs
+
