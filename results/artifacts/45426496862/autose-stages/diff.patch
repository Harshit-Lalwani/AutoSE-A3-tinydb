+        if isinstance(doc_ids, (int, str)):
+            doc_ids = [doc_ids]
+
+        normalized: list[int] = []
+        for doc_id in doc_ids:
+            if isinstance(doc_id, int):
+                normalized.append(doc_id)
+            elif isinstance(doc_id, str):
+                try:
+                    normalized.append(int(doc_id))
+                except ValueError:
+                    # Silently skip unparsable strings
+                    pass
+        return normalized
