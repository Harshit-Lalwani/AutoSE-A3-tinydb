+    def between(self, low: Any, high: Any) -> QueryInstance:
+        """
+        Test a dict value for being within a range (inclusive).
+
+        >>> Query().age.between(18, 65)
+
+        Matches documents where ``18 <= age <= 65``.
+
+        If ``low > high``, the query matches no documents (returns empty result).
+
+        :param low: The lower bound (inclusive)
+        :param high: The upper bound (inclusive)
+        """
+        # If low > high, return a query that always returns False but is still cacheable
+        if low > high:
+            return self._generate_test(
+                lambda value: False,
+                ('between', self._path, freeze(low), freeze(high))
+            )
+
+        return self._generate_test(
+            lambda value: low <= value <= high,
+            ('between', self._path, freeze(low), freeze(high))
+        )
+
